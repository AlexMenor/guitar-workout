---
interface Props { title: string; id: string }
const { title, id } = Astro.props;
---
<div class="practice-heading">
  <a class="back-link" href="/" aria-label="All exercises"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg><span>Exercises</span></a>
  <h1 id={id}>{title}</h1>
</div>
