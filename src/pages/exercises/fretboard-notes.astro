---
import Layout from '../../layouts/Layout.astro';
import PracticeHeading from '../../components/PracticeHeading.astro';
import SessionSettings from '../../components/SessionSettings.astro';
import '../../styles/fretboard.css';
---
<Layout title="Know your notes" description="Memorize all 12 notes across the guitar fretboard with a six-beat, metronome-led practice session.">
  <section class="practice notes-trainer" aria-labelledby="trainer-title" data-trainer>
    <PracticeHeading title="Know your notes" id="trainer-title" />
    <SessionSettings id="note-settings" summary="60 BPM · All notes · 5 minutes">
      <div class="settings-grid">
        <div class="speed-setting"><label class="setting-label" for="tempo">Tempo <span><output id="tempo-output" for="tempo">60</output> BPM</span></label><input id="tempo" type="range" min="20" max="180" step="1" value="60" /><p class="setting-help">Pause to change tempo.</p></div>
        <div><label class="setting-label" for="note-pool">Notes</label><select id="note-pool"><option value="all">All 12 notes</option><option value="accidentals">Accidentals only</option></select><label class="toggle-label accidentals-toggle"><input id="include-flats" type="checkbox" /> Use both ♭ and ♯</label></div>
        <fieldset id="mode-options" class="answer-field"><legend>Practice mode</legend><div class="mode-options"><label><input type="radio" name="mode" value="timed" checked /><span>Timed</span></label><label><input type="radio" name="mode" value="endless" /><span>Endless</span></label></div></fieldset>
        <div id="duration-field"><label class="setting-label" for="duration">Duration</label><select id="duration"><option value="60">1 minute</option><option value="180">3 minutes</option><option value="300" selected>5 minutes</option><option value="600">10 minutes</option><option value="900">15 minutes</option><option value="1800">30 minutes</option></select></div>
      </div>
    </SessionSettings>
    <div class="session-progress"><span>One string per beat</span><span id="session-clock">5:00 remaining</span></div>
    <div class="practice-stage note-workspace">
      <span id="phase" class="sr-only" role="status"></span>
      <div class="note-display"><div class="current-note" aria-live="polite" aria-atomic="true"><span class="note-label" id="note-label">Find this note</span><strong id="current-note">—</strong></div><div class="next-note"><span class="note-label">Up next</span><strong id="next-note">—</strong></div></div>
      <div class="beat-display"><div id="count-in" class="count-in" hidden aria-label="Preparation beats">{[1,2,3,4].map(n => <span data-count-beat={n - 1}>{n}</span>)}</div><ol class="beat-lights" aria-label="Six strings, from low E to high E">{['E','A','D','G','B','e'].map((string, i) => <li data-beat={i} aria-label={`Beat ${i + 1}, ${i === 0 ? 'low E' : i === 5 ? 'high E' : string} string`}>{string}</li>)}</ol></div>
      <p id="cue" class="play-cue">Four clicks to prepare. Then find the note on each string.</p>
      <div class="note-actions"><button id="start" class="primary-button footswitch" disabled>Start practice</button><button id="stop" class="text-button" disabled>End session</button></div>
      <p id="message" class="session-message" role="status"></p>
    </div>
    <div class="session-bottom"><p class="setting-help">Low E to high E. Take it one string at a time.</p><p class="session-stats">Notes completed <strong id="completed">0</strong></p></div>
    <details class="practice-help"><summary>How to practise</summary><p>After four preparation clicks, find the displayed note on all six strings: low E, A, D, G, B, then high E. Each click moves to the next string. A new note arrives every six beats.</p><p>Pause whenever you need. Resuming gives you a fresh count-in and restarts the current note on low E. The metronome pauses when you leave the page.</p></details>
    <noscript><p>Enable JavaScript to use the practice timer and metronome.</p></noscript>
  </section>
</Layout>
<script src="../../scripts/fretboard.ts"></script>
