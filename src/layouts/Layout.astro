---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'A personal collection of guitar exercises. Pick a focus, slow it down, and play.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#f2efdf" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Guitar workout" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{title} · Alex’s guitar workout</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header><a class="brand" href="/"><svg class="brand-pick" aria-hidden="true" viewBox="0 0 32 36"><path d="M16 2C9 2 2 4.5 2 11.5c0 7.2 7.4 18 12 21.5 1.2.9 2.8.9 4 0 4.6-3.5 12-14.3 12-21.5C30 4.5 23 2 16 2Z" fill="currentColor"/><path d="M8 11c0-3 3.6-4.5 8-4.5" fill="none" stroke="#f8e6ce" stroke-opacity=".6" stroke-width="1.5" stroke-linecap="round"/></svg> Alex’s guitar workout</a></header>
      <main id="main"><slot /></main>
      <footer>A little practice, often.</footer>
    </div>
    <aside id="pwa-update" class="pwa-update" role="status" hidden><span>Update ready. Reload when you’ve finished practicing.</span><button id="pwa-reload" type="button">Reload</button></aside>
  </body>
</html>
<script src="../scripts/pwa.ts"></script>
