---
import Layout from '../layouts/Layout.astro';
import ExerciseIcon from '../components/ExerciseIcon.astro';
const exercises = [
  { slug: 'fretboard-notes', title: 'Know your notes', description: 'Find a note across all six strings. Let the metronome keep you moving.', icon: 'notes', detail: 'Play · metronome practice' },
  { slug: 'know-your-chords', title: 'Know your chords', description: 'Connect each scale degree to its chord. Recall roots and build progressions.', icon: 'chords', detail: 'Recall · 10 questions' },
  { slug: 'know-your-intervals', title: 'Know your intervals', description: 'Find relative keys, fourths and fifths. Make the connections feel familiar.', icon: 'intervals', detail: 'Connect · 12 questions' },
  { slug: 'know-your-keys', title: 'Know your keys', description: 'Learn the shape of a chord family. Fill the gaps as the labels fade.', icon: 'keys', detail: 'Study · recall · rebuild' },
] as const;
---
<Layout title="Exercise library">
  <section aria-labelledby="home-title">
    <div class="home-heading"><h1 id="home-title">A little practice,<br /><em>often.</em></h1><p>Pick a focus.<br />Give it your full attention.</p></div>
    <p class="last-practice" id="last-practice" hidden>Last practised: <a id="last-practice-link" href="/">Continue</a></p>
    <div class="exercise-grid">
      {exercises.map(exercise => <a class="exercise-card" href={`/exercises/${exercise.slug}/`}>
        <div class="exercise-topline"><ExerciseIcon name={exercise.icon} /><svg class="open-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></div>
        <h2>{exercise.title}</h2><p>{exercise.description}</p><span class="exercise-caption">{exercise.detail}</span>
      </a>)}
    </div>
    <p class="home-note">Your pace. Your common keys. Progress saved on this device.</p>
  </section>
</Layout>
<script>
  const exercises: Record<string, string> = { 'fretboard-notes': 'Know your notes', 'know-your-chords': 'Know your chords', 'know-your-intervals': 'Know your intervals', 'know-your-keys': 'Know your keys' };
  try {
    const slug = localStorage.getItem('guitar-workout:last-exercise') ?? '';
    if (exercises[slug]) {
      const link = document.querySelector<HTMLAnchorElement>('#last-practice-link')!;
      link.href = `/exercises/${slug}/`; link.textContent = exercises[slug];
      document.querySelector<HTMLElement>('#last-practice')!.hidden = false;
    }
  } catch { /* The exercise library works without storage. */ }
</script>
