---
import Layout from '../../layouts/Layout.astro';
import '../../styles/fretboard.css';
---
<Layout title="Know your notes" description="Memorize all 12 notes across the guitar fretboard with a six-beat, metronome-led practice session.">
  <a class="back-link" href="/">← All exercises</a>
  <section class="trainer" aria-labelledby="trainer-title" data-trainer>
    <h1 id="trainer-title">Know your notes.</h1>
    <div class="panel-top"><span id="phase" role="status"></span><span id="session-clock">5:00 remaining</span></div>
    <div class="pedalboard">
      <div class="pedal current-pedal">
        <div class="current-note" aria-live="polite" aria-atomic="true"><span class="small-label" id="note-label">YOUR NOTE</span><strong id="current-note">—</strong></div>
        <div class="beat-display">
          <div id="count-in" class="count-in" hidden aria-label="Preparation beats">{[1,2,3,4].map(n => <span data-count-beat={n - 1}>{n}</span>)}</div>
          <ol class="beat-lights" aria-label="Six-beat progress">{Array.from({ length: 6 }, (_, i) => <li data-beat={i} aria-label={`Beat ${i + 1}`}></li>)}</ol>
        </div>
        <p id="cue" class="play-cue">Start with four clicks to prepare.</p>
        <button id="start" class="footswitch" disabled>Start practice</button>
      </div>
      <div class="pedal next-pedal">
        <div class="next-note"><span class="small-label">UP NEXT</span><strong id="next-note">—</strong></div>
        <div class="jack" aria-hidden="true"></div>
      </div>
    </div>
    <div class="session-bar"><p id="message" class="session-message" role="status"></p><button id="stop" class="end-session" disabled>End session</button></div>
    <aside class="settings-panel" aria-label="Practice settings">
      <div class="speed-setting">
        <label class="setting-label" for="tempo">Speed <span><output id="tempo-output" for="tempo">60</output> BPM</span></label>
        <input id="tempo" type="range" min="20" max="180" step="1" value="60" />
        <p class="setting-help">Pause to change speed.</p>
      </div>
      <div class="note-setting"><label class="setting-label" for="note-pool">Notes</label><select id="note-pool"><option value="all">All 12 notes</option><option value="accidentals">Accidentals only</option></select></div>
      <fieldset id="mode-options"><legend>Practice mode</legend><div class="mode-options"><label><input type="radio" name="mode" value="timed" checked /><span>Timed</span></label><label><input type="radio" name="mode" value="endless" /><span>Endless</span></label></div></fieldset>
      <div id="duration-field"><label class="setting-label" for="duration">Duration</label><select id="duration"><option value="60">1 minute</option><option value="180">3 minutes</option><option value="300" selected>5 minutes</option><option value="600">10 minutes</option><option value="900">15 minutes</option><option value="1800">30 minutes</option></select></div>
    </aside>
    <div class="session-bottom"><p class="setting-help">Four clicks to prepare. Six beats per note.</p><p class="session-stats">Notes completed <strong id="completed">0</strong></p></div>
    <noscript><p>Enable JavaScript to use the practice timer and metronome.</p></noscript>
  </section>
</Layout>
<script src="../../scripts/fretboard.ts"></script>
